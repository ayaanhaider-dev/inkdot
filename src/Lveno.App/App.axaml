<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lveno.App.App"
             Name="InkDot"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Lveno/Theme/Brand.axaml" />
        <ResourceInclude Source="avares://Lveno/Theme/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="About InkDot" Click="OnAbout" />
      <NativeMenuItemSeparator />
      <NativeMenuItem Header="Settings…" Gesture="Cmd+OemComma" Click="OnSettings" />
      <NativeMenuItem Header="Start at Login" ToggleType="CheckBox" Click="OnStartAtLogin" />
      <NativeMenuItemSeparator />
      <NativeMenuItem Header="Close Window" Gesture="Cmd+W" Click="OnCloseWindow" />
    </NativeMenu>
  </NativeMenu.Menu>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <!-- Ember is the one spark. Everything else is paper, ink and stone. -->
        <ColorPaletteResources x:Key="Light" Accent="#F2551D" AltHigh="#F4F4F1" RegionColor="#F4F4F1"
                               BaseHigh="#121212" ChromeMediumLow="#FBFBF9" ErrorText="#C2410C" />
        <ColorPaletteResources x:Key="Dark" Accent="#F2551D" AltHigh="#121212" RegionColor="#121212"
                               BaseHigh="#F4F4F1" ChromeMediumLow="#1A1A19" ErrorText="#F2551D" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Lveno/Theme/Styles.axaml" />
  </Application.Styles>
</Application>
