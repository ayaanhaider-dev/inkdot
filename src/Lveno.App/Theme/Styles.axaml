<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Type scale. Tighter as type gets bigger: −5.5% display, −4% heading, 0 body, +14% mono caps. -->
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Lv.Font}" />
    <Setter Property="Foreground" Value="{DynamicResource Lv.Fg}" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="34" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-1.9" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.9" />
  </Style>

  <!-- Line icons -->
  <Style Selector="Path.icon">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- Icon rail buttons: icon over a short label -->
  <Style Selector="Button.rail">
    <Setter Property="Width" Value="72" />
    <Setter Property="Height" Value="64" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Lv.Muted}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.rail TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
  </Style>
  <Style Selector="Button.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Lv.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Lv.Fg}" />
  </Style>
  <Style Selector="Button.rail.active">
    <Setter Property="Foreground" Value="{DynamicResource Lv.Fg}" />
  </Style>
  <Style Selector="Button.rail.active TextBlock">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.rail.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Lv.Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Lv.Fg}" />
  </Style>

  <!-- App tabs on the Pen buttons page -->
  <Style Selector="Button.apptab">
    <Setter Property="Background" Value="{DynamicResource Lv.Plate}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lv.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,6,16,6" />
    <Setter Property="Foreground" Value="{DynamicResource Lv.Fg}" />
  </Style>
  <Style Selector="Button.apptab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Lv.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lv.Muted}" />
    <Setter Property="Foreground" Value="{DynamicResource Lv.Fg}" />
  </Style>
  <Style Selector="Button.apptab.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Lv.Hover}" />
    <Setter Property="BorderBrush" Value="{StaticResource Lv.Ember}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="Button.apptab.add">
    <Setter Property="Padding" Value="10" />
  </Style>

  <!-- Dropdowns: quiet border, rounded, brand fonts -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Lv.Bg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lv.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Lv.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lv.Muted}" />
  </Style>
  <Style Selector="ComboBox:dropdownopen /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{StaticResource Lv.Ember}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.4" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Lv.Muted}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontFamily" Value="{StaticResource Lv.Mono}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LetterSpacing" Value="1.5" />
    <Setter Property="Foreground" Value="{DynamicResource Lv.Muted}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource Lv.Mono}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource Lv.AccentText}" />
  </Style>

  <!-- Cards -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Lv.Plate}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lv.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Lv.CardRadius}" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Lv.Line}" />
  </Style>

  <!-- Buttons: pill shapes. Primary is the single ember action on a screen. -->
  <Style Selector="Button">
    <Setter Property="FontFamily" Value="{StaticResource Lv.Font}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource Lv.Ember}" />
    <Setter Property="Foreground" Value="{StaticResource Lv.Ink}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="22,10" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Lv.EmberHover}" />
    <Setter Property="Foreground" Value="{StaticResource Lv.Ink}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Lv.EmberPressed}" />
    <Setter Property="Foreground" Value="{StaticResource Lv.Ink}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Lv.Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Lv.Muted}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lv.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Lv.Fg}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Lv.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lv.Muted}" />
    <Setter Property="Foreground" Value="{DynamicResource Lv.Fg}" />
  </Style>
  <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Lv.Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Lv.Fg}" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Lv.AccentText}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Lv.Fg}" />
  </Style>

  <!-- Sidebar navigation -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Lv.Muted}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Lv.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Lv.Fg}" />
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Foreground" Value="{DynamicResource Lv.Fg}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.nav TextBlock">
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.nav Path.icon">
    <Setter Property="Width" Value="19" />
    <Setter Property="Height" Value="19" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Lv.Line}" />
  </Style>

  <!-- Text field: pill, paper/ink, ember outline when typing -->
  <Style Selector="TextBox.field">
    <Setter Property="FontFamily" Value="{StaticResource Lv.Font}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Lv.Fg}" />
    <Setter Property="Background" Value="{DynamicResource Lv.Bg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lv.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Lv.Bg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lv.Muted}" />
  </Style>
  <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Lv.Bg}" />
    <Setter Property="BorderBrush" Value="{StaticResource Lv.Ember}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="TextBox.field:focus">
    <Setter Property="Foreground" Value="{DynamicResource Lv.Fg}" />
  </Style>
  <Style Selector="TextBox.field /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{DynamicResource Lv.Muted}" />
  </Style>
  <Style Selector="TextBox.field:focus /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{DynamicResource Lv.Muted}" />
  </Style>

  <!-- Quick preset cards -->
  <Style Selector="Button.presetcard">
    <Setter Property="Background" Value="{DynamicResource Lv.Plate}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lv.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.presetcard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Lv.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lv.Muted}" />
  </Style>
  <Style Selector="Button.presetcard.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource Lv.Ember}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Curve preset buttons -->
  <Style Selector="Button.preset">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="7" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource Lv.Plate}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lv.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.preset:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Lv.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lv.Muted}" />
  </Style>
  <Style Selector="Button.preset.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Lv.Hover}" />
    <Setter Property="BorderBrush" Value="{StaticResource Lv.Ember}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Segmented control: a pill holding equal buttons; the chosen one is ink. -->
  <Style Selector="Border.segments">
    <Setter Property="Background" Value="{DynamicResource Lv.Bg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Lv.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="Button.seg">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Lv.Muted}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="Button.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Lv.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Lv.Fg}" />
  </Style>
  <Style Selector="Button.seg.active">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.seg.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Lv.Fg}" />
    <Setter Property="Foreground" Value="{DynamicResource Lv.Bg}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource Lv.Font}" />
    <Setter Property="MinWidth" Value="220" />
  </Style>
  <Style Selector="ToggleSwitch">
    <Setter Property="FontFamily" Value="{StaticResource Lv.Font}" />
  </Style>
</Styles>
