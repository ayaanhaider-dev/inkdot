<Project>
  <!-- Applies to Lveno projects under src/. OpenTabletDriver keeps its own Directory.Build.props in external/. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <Company>Lveno</Company>
    <Product>InkDot by Lveno</Product>
    <Copyright>© 2026 Lveno</Copyright>
  </PropertyGroup>
</Project>
